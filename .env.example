# Build-time configuration. Copy to `.env.local` (gitignored) and fill in.
# Expo inlines EXPO_PUBLIC_* variables into the JS bundle when the APK is
# built (`yarn build:apk`), so the app works from the first launch.

# GitHub personal access token with read access to the contents of the
# private repository that holds the MDict dictionaries
# (mediacloner/penReader → dictionaries/). A fine-grained token limited to
# that one repository is enough. A token saved in Settings → Dictionaries
# overrides this one. NEVER put a real token in a committed file.
EXPO_PUBLIC_GITHUB_TOKEN=
